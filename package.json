{
  "name": "befui",
  "version": "1.7.2",
  "license": "MIT",
  "description": "Copy-paste React components (Radix, Tailwind 4, CSS variables) with a CLI, MCP server and llms.txt for AI tools.",
  "homepage": "https://github.com/RandomKid24/befui#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RandomKid24/befui.git"
  },
  "bugs": {
    "url": "https://github.com/RandomKid24/befui/issues"
  },
  "keywords": [
    "react",
    "components",
    "ui",
    "tailwind",
    "radix",
    "shadcn",
    "copy-paste",
    "mcp",
    "llms-txt",
    "cli"
  ],
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run registry:build && tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "stories:gen": "node scripts/gen-stories.mjs",
    "storybook": "npm run stories:gen && storybook dev -p 6006",
    "build-storybook": "npm run stories:gen && storybook build -o dist-storybook",
    "registry:build": "node scripts/build-registry.mjs",
    "prepublishOnly": "npm run build",
    "version": "node scripts/changelog-check.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-checkbox": "^1.3.2",
    "@radix-ui/react-context-menu": "^2.3.8",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-direction": "^1.2.0",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-hover-card": "^1.2.1",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-menubar": "^1.2.1",
    "@radix-ui/react-navigation-menu": "^1.4.1",
    "@radix-ui/react-popover": "^1.1.14",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.5",
    "@radix-ui/react-tabs": "^1.1.12",
    "@radix-ui/react-toggle-group": "^1.1.10",
    "@radix-ui/react-tooltip": "^1.2.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^0.562.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^10.6.1",
    "@storybook/addon-docs": "^10.6.1",
    "@storybook/addon-themes": "^10.6.1",
    "@storybook/react-vite": "^10.6.1",
    "@tailwindcss/vite": "^4.1.11",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.14.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^5.0.0",
    "jsdom": "^30.1.2",
    "storybook": "^10.6.1",
    "tailwindcss": "^4.1.11",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vitest": "^3.2.7",
    "vitest-axe": "^0.1.0"
  },
  "bin": {
    "befui": "bin/befui.mjs"
  },
  "files": [
    "bin",
    "public/r",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  }
}
